## Step 7: Create the Selenium testing file

Now return to the Explorer panel in VS Code.

1. Click New File.
2. Name it:

`test.js`

3\. Copy this entire code into it:

```

const { Builder, By } = require("selenium-webdriver");
const assert = require("node:assert/strict");
const path = require("node:path");
const { pathToFileURL } = require("node:url");

async function testCounter() {

    const driver = await new Builder()
        .forBrowser("chrome")
        .build();

    try {

        const filePath = pathToFileURL(
            path.resolve(__dirname, "index.html")
        ).href;

        await driver.get(filePath);

        const output = await driver.findElement(By.id("output"));

        const button = await driver.findElement(
            By.id("increment-button")
        );

        assert.equal(await output.getText(), "0");
        console.log("Initial value is 0");

        await button.click();

        assert.equal(await output.getText(), "1");
        console.log("Counter becomes 1");

        await button.click();

        assert.equal(await output.getText(), "2");
        console.log("Counter becomes 2");

        console.log("All tests passed successfully!");

    } finally {
        await driver.quit();
    }
}

testCounter().catch(error => {
    console.error(error);
    process.exitCode = 1;
});

```

Press Ctrl + S to save.

